# copie esse arquivo pra ".env" e preencha (o .env não vai pro github)
# na vercel coloque as mesmas variáveis em Settings > Environment Variables

# endereço do mongodb atlas (Database > Connect > Drivers)
# se ficar vazio no pc, usa um banco temporário só pra teste
MONGODB_URI=

# chave secreta do login, qualquer texto grande e aleatório
SESSAO_SEGREDO=

# endereço secreto do painel, sem barra (ex: painel-imprimifacil-x7k2)
ADMIN_CAMINHO=

# senha do admin criado na primeira vez que o site sobe
ADMIN_SENHA=
