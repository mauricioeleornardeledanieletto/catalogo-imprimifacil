# Copie este arquivo para ".env" e preencha. O .env NÃO vai para o GitHub.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# Endereço de conexão do MongoDB Atlas (Database > Connect > Drivers).
# Se ficar vazio no computador, o projeto usa um banco temporário só para testes.
MONGODB_URI=

# Chave secreta que assina o login. Use um texto longo e aleatório.
SESSAO_SEGREDO=

# Endereço secreto do painel (sem barra). Ex.: painel-imprimifacil-x7k2
ADMIN_CAMINHO=

# Senha do usuário "admin" criado na primeira vez que o site sobe.
ADMIN_SENHA=
